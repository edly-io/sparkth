msgstr "Enregistrer un nouveau fournisseur d'IA et sa clé."

#: sparkth/core/permissions/__init__.py
msgid "See AI key settings"
msgstr "Voir les réglages des clés d'IA"

#: sparkth/core/permissions/__init__.py
msgid "View saved AI providers and models."
msgstr "Voir les fournisseurs et modèles d'IA enregistrés."

#: sparkth/core/permissions/__init__.py
msgid "Change AI keys"
msgstr "Modifier les clés d'IA"

#: sparkth/core/permissions/__init__.py
msgid "Edit, rotate or switch the active AI key."
msgstr "Modifier, renouveler ou changer la clé d'IA active."

#: sparkth/core/permissions/__init__.py
msgid "Delete AI keys"
msgstr "Supprimer des clés d'IA"

#: sparkth/core/permissions/__init__.py
msgid "Remove saved AI keys."
msgstr "Supprimer les clés d'IA enregistrées."

#: sparkth/core/permissions/__init__.py
msgid "Use plugins"
msgstr "Utiliser les plugins"

#: sparkth/core/permissions/__init__.py
msgid "Use a plugin's features, such as Compose or Google Drive."
msgstr "Utiliser les fonctions d'un plugin, comme Compose ou Google Drive."

#: sparkth/core/permissions/__init__.py
msgid "Switch plugins on or off"
msgstr "Activer ou désactiver les plugins"

#: sparkth/core/permissions/__init__.py
msgid ""
"Turn a plugin on or off for every user, which hides it and refuses its "
"requests."
msgstr ""
"Activer ou désactiver un plugin pour tous les utilisateurs, ce qui le masque "
"et refuse ses requêtes."

#: sparkth/core/permissions/__init__.py
msgid "Upload files"
msgstr "Téléverser des fichiers"

#: sparkth/core/permissions/__init__.py
