#: sparkth/core/permissions/__init__.py
msgid "View analytics"
msgstr "Voir l'analytique"

#: sparkth/core/permissions/__init__.py
msgid "Open the analytics dashboards and run Explore queries."
msgstr "Ouvrir les tableaux de bord d'analytique et lancer des requêtes Explorer."

#: sparkth/core/permissions/__init__.py
msgid "View the audit log"
msgstr "Voir le journal d'audit"

#: sparkth/core/permissions/__init__.py
msgid "Read and export the record of every access change."
msgstr "Lire et exporter l'historique de chaque changement d'accès."

#: sparkth/core/permissions/__init__.py
msgid "See information about users"
msgstr "Voir des informations sur les utilisateurs"

#: sparkth/core/permissions/__init__.py
msgid "List the people in Sparkth with their email addresses, and see who did what in analytics."
msgstr "Lister les personnes dans Sparkth avec leurs adresses e-mail, et voir qui a fait quoi dans l'analytique."

