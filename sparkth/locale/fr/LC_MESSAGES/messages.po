#: sparkth/core/permissions/__init__.py
msgid "Edit groups"
msgstr "Modifier les groupes"

#: sparkth/core/permissions/__init__.py
msgid "Rename groups and change their description."
msgstr "Renommer les groupes et modifier leur description."

#: sparkth/core/permissions/__init__.py
msgid "Delete groups"
msgstr "Supprimer des groupes"

