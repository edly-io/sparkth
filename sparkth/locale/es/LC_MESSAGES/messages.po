#: sparkth/core/plugins/middleware.py:106
#, python-brace-format
msgid ""
"Plugin '{name}' is switched off, either in your settings or by an "
"administrator."
msgstr ""
"El plugin '{name}' está deshabilitado, ya sea en tu configuración o por "
"un administrador."

#: sparkth/core/plugins/service.py:159 sparkth/core/plugins/service.py:165
#, python-brace-format
msgid "Plugin '{name}' cannot be configured at this time."
msgstr "El plugin '{name}' no se puede configurar en este momento."

#: sparkth/core/plugins/service.py:411
msgid "Cannot update plugin configuration while the plugin is disabled"
msgstr ""
"No se puede actualizar la configuración del plugin mientras está "
"deshabilitado"

#: sparkth/lib/auth.py:172
msgid "Could not validate credentials"
msgstr "No se pudieron validar las credenciales"

#: sparkth/llm/adapter.py:70
msgid ""
"This record is deactivated. Reactivate it in AI Keys or select a "
"different config."
msgstr ""
"Este registro está desactivado. Reactívalo en AI Keys o selecciona otra "
"configuración."

#: sparkth/llm/adapter.py:76 sparkth/llm/service.py:170
#, python-brace-format
msgid ""
"Model '{model}' not available for provider '{provider}'. Allowed: "
"{allowed}"
msgstr ""
"El modelo '{model}' no está disponible para el proveedor '{provider}'. "
"Permitidos: {allowed}"

#: sparkth/llm/exceptions.py:9
#, python-brace-format
msgid "LLMConfig {config_id} not found for user {user_id}"
msgstr "LLMConfig {config_id} no encontrada para el usuario {user_id}"

#: sparkth/llm/exceptions.py:27
msgid ""
"The selected AI configuration is deactivated. Go to AI Keys to reactivate"
" it, or choose a different configuration in the chat settings."
msgstr ""
"La configuración de IA seleccionada está desactivada. Ve a AI Keys para "
"reactivarla o elige otra configuración en los ajustes del chat."

#: sparkth/llm/exceptions.py:37
#, python-brace-format
msgid "An LLM config with name '{name}' already exists for this user."
msgstr ""
"Ya existe una configuración de LLM con el nombre '{name}' para este "
"usuario."

#: sparkth/rag/exceptions.py:31
msgid ""
"This PDF appears to be scanned (image-only pages with no extractable "
"text). OCR-based ingestion is not yet supported — please upload a text-"
"based PDF."
msgstr ""
"Este PDF parece estar escaneado (páginas de solo imagen sin texto "
"extraíble). La ingesta basada en OCR aún no es compatible; sube un PDF "
"basado en texto."

#: sparkth/services/account/password_reset.py:169
#: sparkth/services/email_verification.py:134
#, python-brace-format
msgid "Hi {name},"
msgstr "Hola {name}:"

#: sparkth/services/email_verification.py:135
msgid "Click the link below to confirm your email address:"
msgstr ""
"Haz clic en el enlace de abajo para confirmar tu dirección de correo "
"electrónico:"

#: sparkth/services/email_verification.py:136
#, python-brace-format
msgid "This link expires in {ttl} hours."
msgstr "Este enlace caduca en {ttl} horas."

#: sparkth/services/email_verification.py:137
msgid "If you didn't sign up for Sparkth, you can ignore this email."
msgstr "Si no te registraste en Sparkth, puedes ignorar este correo."

#: sparkth/services/email_verification.py:138
msgid "Confirm my email"
msgstr "Confirmar mi correo"

#: sparkth/services/email_verification.py:158
msgid "Confirm your Sparkth account"
msgstr "Confirma tu cuenta de Sparkth"

#: sparkth/services/account/password_reset.py:133
msgid "This password reset link is invalid or has already been used."
msgstr "Este enlace para restablecer la contraseña no es válido o ya se ha usado."

#: sparkth/services/account/password_reset.py:137
msgid "This password reset link has expired. Request a new one."
msgstr "Este enlace para restablecer la contraseña ha caducado. Solicita uno nuevo."

#: sparkth/services/account/password_reset.py:170
msgid ""
"We received a request to reset your Sparkth password. Click the link "
"below to choose a new one:"
msgstr ""
"Recibimos una solicitud para restablecer tu contraseña de Sparkth. Haz "
"clic en el enlace de abajo para elegir una nueva:"

#: sparkth/services/account/password_reset.py:171
#, python-brace-format
msgid "This link expires in {minutes} minutes."
msgstr "Este enlace caduca en {minutes} minutos."

#: sparkth/services/account/password_reset.py:172
msgid "If you didn't ask to reset your password, you can ignore this email."
msgstr ""
"Si no solicitaste restablecer tu contraseña, puedes ignorar este correo."

#: sparkth/services/account/password_reset.py:173
msgid "Reset my password"
msgstr "Restablecer mi contraseña"

#: sparkth/services/account/password_reset.py:192
msgid "Reset your Sparkth password"
msgstr "Restablece tu contraseña de Sparkth"

#: sparkth/services/account/service.py:38
msgid "SSO based sign-ins cannot update passwords."
msgstr ""
"Las cuentas que inician sesión con SSO no pueden cambiar la contraseña."

#: sparkth/services/account/service.py:47
msgid "Your current password is incorrect."
msgstr "Tu contraseña actual es incorrecta."

