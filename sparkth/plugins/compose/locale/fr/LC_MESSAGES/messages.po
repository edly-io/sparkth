#: sparkth/plugins/compose/constants.py:85
msgid ""
"I'm a course creation assistant and can only help with designing and "
"building courses."
msgstr ""
"Je suis un assistant de création de cours et je peux uniquement vous "
"aider à concevoir et à créer des cours."

# Machine-generated translation (LLM), not yet reviewed by a native speaker.
#: sparkth/plugins/compose/constants.py:90
msgid ""
"I've done as much as I can in one go. Send another message and I'll carry"
" on from here."
msgstr ""
"J'ai fait tout ce que je pouvais en une seule fois. Envoyez un autre "
"message et je reprendrai à partir d'ici."

# Machine-generated translation (LLM), not yet reviewed by a native speaker.
#: sparkth/plugins/compose/planner/middleware.py:107
msgid ""
"Something went wrong and I couldn't finish this. Please send your message"
" again."
msgstr ""
"Une erreur s'est produite et je n'ai pas pu terminer. Veuillez renvoyer "
"votre message."

# Machine-generated translation (LLM), not yet reviewed by a native speaker.
