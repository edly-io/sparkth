{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@/core/**", "@/app/**"],
            "message": "Plugins import core code through @/lib, never from @/core or @/app."
          },
          {
            "group": [
              "@/plugins/**",
              "!@/plugins/moodle",
              "!@/plugins/moodle/**",
              "!@/plugins/*/lib",
              "!@/plugins/*/lib/**"
            ],
            "message": "A plugin imports another plugin only through that plugin's lib/."
          },
          {
            "group": ["../*", "../**"],
            "message": "A plugin imports outside its folder by @/ path, never by ../ relative path."
          }
        ]
      }
    ]
  }
}
