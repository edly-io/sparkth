{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "overrides": [
    {
      "files": ["core/**", "lib/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/plugins/**"],
                "message": "Core and lib never import a plugin; a plugin contributes to them through a slot."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["plugins/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/core/**", "@/app/**"],
                "message": "Plugins import core code through @/lib, never from @/core or @/app."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["plugins/canvas/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/core/**", "@/app/**"],
                "message": "Plugins import core code through @/lib, never from @/core or @/app."
              },
              {
                "group": [
                  "@/plugins/**",
                  "!@/plugins/canvas",
                  "!@/plugins/canvas/**",
                  "!@/plugins/*/lib",
                  "!@/plugins/*/lib/**"
                ],
                "message": "A plugin imports another plugin only through that plugin's lib/."
              }
            ]
          }
        ]
      }
    },
    {
