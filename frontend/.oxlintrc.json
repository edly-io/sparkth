{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "overrides": [
    {
      "files": ["core/**", "lib/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/plugins/**"],
                "message": "Core and lib never import a plugin; a plugin contributes to them through a slot."
              }
            ]
          }
        ]
      }
    }
  ]
}
